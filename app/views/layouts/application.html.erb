<!DOCTYPE html>
<html>
  <head>
    <title>FoundrySocial</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-100 min-h-screen text-slate-900">
    <main class="mx-auto max-w-3xl p-6">
      <% if notice %>
        <p class="mb-4 rounded bg-emerald-100 p-3 text-emerald-800"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-4 rounded bg-rose-100 p-3 text-rose-800"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
