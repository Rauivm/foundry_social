<article class="rounded bg-white p-4 shadow">
  <div class="mb-2 flex items-center justify-between text-sm text-slate-500">
    <strong class="text-slate-800"><%= post.character_name %></strong>
    <span><%= time_ago_in_words(post.created_at) %> ago</span>
  </div>
  <p class="whitespace-pre-wrap"><%= post.content %></p>
</article>
