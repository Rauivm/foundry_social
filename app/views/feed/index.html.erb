<div class="space-y-6">
  <header class="rounded bg-white p-4 shadow">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">Foundry Feed</h1>
        <p class="text-sm text-slate-600"><%= current_user.email %></p>
      </div>
      <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "rounded bg-slate-900 px-3 py-2 text-white" %>
    </div>

    <div class="mt-4 flex items-center gap-2">
      <%= form_with url: switch_character_path, method: :patch, class: "flex items-center gap-2" do %>
        <%= select_tag :character_id, options_from_collection_for_select(@characters, :id, :name, current_character&.id), include_blank: "Select character", class: "rounded border p-2" %>
        <%= submit_tag "Switch", class: "rounded bg-indigo-600 px-3 py-2 text-white" %>
      <% end %>
      <%= link_to "Manage characters", characters_path, class: "text-sm text-indigo-700 underline" %>
    </div>
  </header>

  <section class="rounded bg-white p-4 shadow">
    <%= form_with model: @post, url: posts_path do |f| %>
      <%= f.text_area :content, maxlength: 280, rows: 4, class: "w-full rounded border p-3", placeholder: "What's happening?" %>
      <div class="mt-3">
        <%= f.submit "Post", class: "rounded bg-indigo-600 px-4 py-2 text-white" %>
      </div>
    <% end %>
  </section>

  <section id="posts" class="space-y-3">
    <%= render @posts %>
  </section>
</div>
