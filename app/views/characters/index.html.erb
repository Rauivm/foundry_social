<div class="space-y-6">
  <h1 class="text-2xl font-bold">Your Characters</h1>

  <section class="rounded bg-white p-4 shadow">
    <%= form_with model: @character, url: characters_path do |f| %>
      <%= f.label :name %>
      <%= f.text_field :name, class: "mt-1 w-full rounded border p-2" %>
      <%= f.submit "Create", class: "mt-3 rounded bg-indigo-600 px-4 py-2 text-white" %>
    <% end %>
  </section>

  <section class="rounded bg-white p-4 shadow">
    <ul class="space-y-2">
      <% @characters.each do |character| %>
        <li class="rounded border p-2"><%= character.name %></li>
      <% end %>
    </ul>
  </section>

  <%= link_to "Back to feed", feed_path, class: "text-indigo-700 underline" %>
</div>
